{
	"name": "WWT_Points_to_Rise",
	"properties": {
		"description": "Draft Dataflow: If Geo SCADA fullname starts with any of the Source site names, replace the old site name with the new rise site name",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "GeoSCADAObjects"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "SiteMapping"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "PointMapping"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "WasteModelOffice"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "SinkToDB"
				}
			],
			"transformations": [
				{
					"name": "BuildRiseNames"
				},
				{
					"name": "ColumnsForOutput"
				},
				{
					"name": "SortByFullname"
				},
				{
					"name": "Upsert"
				},
				{
					"name": "FindPointsMapping"
				},
				{
					"name": "FinalRiseNames"
				},
				{
					"name": "DebuggingFilter"
				},
				{
					"name": "SitesInWasteModelOffice"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          fullname as string,",
				"          typename as string,",
				"          properties as string,",
				"          aggregates as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT * FROM public.wwt_objects',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> GeoSCADAObjects",
				"source(output(",
				"          source_system as string,",
				"          source_site_fullname as string,",
				"          l1_catchment_or_region as string,",
				"          l2_stw_catchment_or_hydraulic_system as string,",
				"          l3_treatment_network_or_production as string,",
				"          l4_site_name as string,",
				"          rise_sitename as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT *,\\n       CONCAT_WS(\\'.\\',\\n           l1_catchment_or_region,\\n           l2_stw_catchment_or_hydraulic_system,\\n           l3_treatment_network_or_production,\\n           l4_site_name\\n       ) AS rise_sitename\\nFROM site_mapping\\nWHERE source_system = \\'WWT\\'',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> SiteMapping",
				"source(output(",
				"          legacy_scada as string,",
				"          l4_site_name as string,",
				"          l5_process_group as string,",
				"          l6_asset_l1 as string,",
				"          l7_asset_l2 as string,",
				"          l8_signal as string,",
				"          extracted_site as string,",
				"          match_key as string,",
				"          generalised_key as string,",
				"          review_status as string,",
				"          confirmed_l5_process_group as string,",
				"          confirmed_l6_asset_l1 as string,",
				"          confirmed_l7_asset_l2 as string,",
				"          confirmed_l8_signal as string,",
				"          point_type as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT * FROM public.legacy_scada_mapping',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> PointMapping",
				"source(output(",
				"          current_fullname as string,",
				"          new_fullname as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT * FROM public.waste_model_office',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> WasteModelOffice",
				"DebuggingFilter derive(point_shortname = split(fullname, '.')[size(split(fullname, '.'))],",
				"          point_relativename = right(fullname, length(fullname) - length(current_fullname)-1)\r",
				"/*right(fullname, length(fullname) - length(source_site_fullname)-1)*/,",
				"          rise_relativename = iif(\r",
				"    lower(l5_process_group) == 'unknown' ||\r",
				"    lower(l6_asset_l1) == 'unknown' ||\r",
				"    lower(l7_asset_l2) == 'unknown' ||\r",
				"    lower(l8_signal) == 'unknown',\r",
				"\r",
				"    right(fullname, length(fullname) - length(current_fullname) - 1),\r",
				"\r",
				"    concatWS(\r",
				"        '.',\r",
				"        iif(isNull(l5_process_group), '', l5_process_group),\r",
				"        iif(isNull(l6_asset_l1), '', l6_asset_l1),\r",
				"        iif(isNull(l7_asset_l2), '', l7_asset_l2),\r",
				"        iif(isNull(l8_signal), '', l8_signal)\r",
				"    )\r",
				")) ~> BuildRiseNames",
				"FinalRiseNames select(mapColumn(",
				"          fullname = rise_fullname,",
				"          properties,",
				"          typename,",
				"          aggregates",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnsForOutput",
				"ColumnsForOutput sort(asc(fullname, true)) ~> SortByFullname",
				"SortByFullname alterRow(upsertIf(true())) ~> Upsert",
				"SitesInWasteModelOffice, PointMapping join(fullname == legacy_scada,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> FindPointsMapping",
				"BuildRiseNames derive(rise_fullname = concat(new_fullname,'.', rise_relativename)) ~> FinalRiseNames",
				"FindPointsMapping filter(/*fullname=='WESTERN.READING.BASINGSTOKE.Stoneyfield SPS.Analogue.Average Calculation' || fullname=='WESTERN.READING.BASINGSTOKE.Stoneyfield SPS.Communications.GPRS Signal Strength' */\r",
				"true() /*enable this line to disable the filter*/) ~> DebuggingFilter",
				"GeoSCADAObjects, WasteModelOffice join(startsWith(fullname, concat(current_fullname, '.')),",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> SitesInWasteModelOffice",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'rise_objects',",
				"     schemaName: 'public',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['fullname'],",
				"     store: 'postgres',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkToDB"
			]
		}
	}
}