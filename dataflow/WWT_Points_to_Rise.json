{
	"name": "WWT_Points_to_Rise",
	"properties": {
		"description": "Draft Dataflow: If Geo SCADA fullname starts with any of the Source site names, replace the old site name with the new rise site name",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_POST_WWT_Objects",
						"type": "DatasetReference"
					},
					"name": "GeoSCADAObjects"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "SiteMapping"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "SinkToDB"
				}
			],
			"transformations": [
				{
					"name": "PointsWithValidSiteMapping"
				},
				{
					"name": "BuildRiseNames"
				},
				{
					"name": "ColumnsForOutput"
				},
				{
					"name": "SortByFullname"
				},
				{
					"name": "Upsert"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          fullname as string,",
				"          typename as string,",
				"          properties as string,",
				"          aggregates as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM public.wwt_objects \\nWHERE typename IN (\\'CDNP3AnalogIn\\',\\'CDNP3AnalogOut\\',\\'CDNP3BinaryIn\\',\\'CDNP3String\\',\\'CICMPDigital\\',\\'CNTMonAlgPoint\\',\\'COdbcAlgPoint\\',\\'COdbcDigitalPoint\\',\\'COpcAlgPoint\\',\\'COpcDigitalPoin\\',\\'COpcTimePoint\\',\\'COpcXmlDaAlgPoint\\',\\'COpcXmlDaDigitalPoint\\',\\'COpcXmlDaStrPoint\\',\\'CProteusAIP\\',\\'CProteusAOP\\',\\'CProteusCA\\',\\'CProteusCD\\',\\'CProteusDGM\\',\\'CProteusDIP\\',\\'CProteusDOP\\',\\'CProteusDiurnal\\',\\'CProteusInt\\',\\'CProteusMax\\',\\'CProteusMean\\',\\'CProteusMin\\',\\'CProteusROC2\\',\\'CProteusRuntime\\',\\'CSNMPInteger\\',\\'CSNMPString\\',\\'CUP2000AIP4Limi\\',\\'CUP2000ChannelPSTN\\',\\'CUP2000DIP\\',\\'CUP2000OSPSTN\\',\\'CUP2000SetPSTN\\',\\'CWITSAnalogIn\\',\\'CWITSAnalogOut\\',\\'CWITSAppProgram\\',\\'CWITSBinaryIn\\',\\'CWITSBinaryNoChange\\',\\'CWITSBinaryOut\\',\\'CWITSCounter\\',\\'CWITSIntegrator\\',\\'CWITSMaximum\\',\\'CWITSMean\\',\\'CWITSMinimum\\',\\'CWITSPulseTripClose\\',\\'CWITSROC\\',\\'CWITSRuntime\\',\\'CWITSStateCounter\\',\\'HTMonitorPoint\\',\\'SparkplugBPointAg\\',\\'SparkplugBPointDg\\',\\'SparkplugBPointSt\\')',",
				"     format: 'query') ~> GeoSCADAObjects",
				"source(output(",
				"          source_system as string,",
				"          source_site_fullname as string,",
				"          l1_catchment_or_region as string,",
				"          l2_stw_catchment_or_hydraulic_system as string,",
				"          l3_treatment_network_or_production as string,",
				"          l4_site_name as string,",
				"          rise_sitename as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT *,\\n       CONCAT_WS(\\'.\\',\\n           l1_catchment_or_region,\\n           l2_stw_catchment_or_hydraulic_system,\\n           l3_treatment_network_or_production,\\n           l4_site_name\\n       ) AS rise_sitename\\nFROM site_mapping\\nWHERE source_system = \\'WWT\\'',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> SiteMapping",
				"GeoSCADAObjects, SiteMapping join(startsWith(fullname, concat(source_site_fullname, '.')),",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> PointsWithValidSiteMapping",
				"PointsWithValidSiteMapping derive(l5 = split(fullname,'.')[5],",
				"          point_shortname = split(fullname, '.')[size(split(fullname, '.'))],",
				"          point_relativename = right(fullname, length(fullname) - length(source_site_fullname)-1),",
				"          rise_fullname = concat(rise_sitename,'.', right(fullname, length(fullname) - length(source_site_fullname)-1))) ~> BuildRiseNames",
				"BuildRiseNames select(mapColumn(",
				"          typename,",
				"          properties,",
				"          aggregates,",
				"          fullname = rise_fullname",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnsForOutput",
				"ColumnsForOutput sort(asc(fullname, true)) ~> SortByFullname",
				"SortByFullname alterRow(upsertIf(true())) ~> Upsert",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     store: 'postgres',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkToDB"
			]
		}
	}
}