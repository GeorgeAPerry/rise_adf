{
	"name": "WWT_Points_to_Rise",
	"properties": {
		"description": "Draft Dataflow: If Geo SCADA fullname starts with any of the Source site names, replace the old site name with the new rise site name",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "GeoSCADAObjects"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "SiteMapping"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "PointMapping"
				},
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "WasteModelOffice"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzurePostgreSql_postgres_DB",
						"type": "LinkedServiceReference"
					},
					"name": "SinkToDB"
				},
				{
					"linkedService": {
						"referenceName": "ls_risedevstorage01",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"linkedService": {
						"referenceName": "ls_risedevstorage01",
						"type": "LinkedServiceReference"
					},
					"name": "sink2"
				},
				{
					"linkedService": {
						"referenceName": "ls_risedevstorage01",
						"type": "LinkedServiceReference"
					},
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "BuildRiseNames"
				},
				{
					"name": "ColumnsForOutput"
				},
				{
					"name": "SortByFullname"
				},
				{
					"name": "Upsert"
				},
				{
					"name": "FindPointsMapping"
				},
				{
					"name": "FinalRiseNames"
				},
				{
					"name": "DebuggingFilter"
				},
				{
					"name": "SitesInWasteModelOffice"
				},
				{
					"name": "split1"
				},
				{
					"name": "Split2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select2"
				},
				{
					"name": "sort2"
				},
				{
					"name": "window2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          fullname as string,",
				"          typename as string,",
				"          properties as string,",
				"          aggregates as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT * FROM public.wwt_objects',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> GeoSCADAObjects",
				"source(output(",
				"          source_system as string,",
				"          source_site_fullname as string,",
				"          l1_catchment_or_region as string,",
				"          l2_stw_catchment_or_hydraulic_system as string,",
				"          l3_treatment_network_or_production as string,",
				"          l4_site_name as string,",
				"          rise_sitename as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT *,\\n       CONCAT_WS(\\'.\\',\\n           l1_catchment_or_region,\\n           l2_stw_catchment_or_hydraulic_system,\\n           l3_treatment_network_or_production,\\n           l4_site_name\\n       ) AS rise_sitename\\nFROM site_mapping\\nWHERE source_system = \\'WWT\\'',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> SiteMapping",
				"source(output(",
				"          legacy_scada as string,",
				"          l4_site_name as string,",
				"          l5_process_group as string,",
				"          l6_asset_l1 as string,",
				"          l7_asset_l2 as string,",
				"          l8_signal as string,",
				"          extracted_site as string,",
				"          match_key as string,",
				"          generalised_key as string,",
				"          review_status as string,",
				"          confirmed_l5_process_group as string,",
				"          confirmed_l6_asset_l1 as string,",
				"          confirmed_l7_asset_l2 as string,",
				"          confirmed_l8_signal as string,",
				"          point_type as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT * FROM public.legacy_scada_mapping',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> PointMapping",
				"source(output(",
				"          current_fullname as string,",
				"          new_fullname as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     query: 'SELECT * FROM public.waste_model_office',",
				"     store: 'postgres',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> WasteModelOffice",
				"DebuggingFilter derive(point_shortname = split(fullname, '.')[size(split(fullname, '.'))],",
				"          point_relativename = right(fullname, length(fullname) - length(current_fullname)-1)\r",
				"/*right(fullname, length(fullname) - length(source_site_fullname)-1)*/,",
				"          rise_relativename = iif(\r",
				"    lower(l5_process_group) == 'unknown' ||\r",
				"    lower(l6_asset_l1) == 'unknown' ||\r",
				"    lower(l7_asset_l2) == 'unknown' ||\r",
				"    lower(l8_signal) == 'unknown',\r",
				"\r",
				"    right(fullname, length(fullname) - length(current_fullname) - 1),\r",
				"\r",
				"    concatWS(\r",
				"        '.',\r",
				"        iif(isNull(l5_process_group), '', l5_process_group),\r",
				"        iif(isNull(l6_asset_l1), '', l6_asset_l1),\r",
				"        iif(isNull(l7_asset_l2), '', l7_asset_l2),\r",
				"        iif(isNull(l8_signal), '', l8_signal)\r",
				"    )\r",
				")) ~> BuildRiseNames",
				"filter2 select(mapColumn(",
				"          fullname = rise_fullname,",
				"          properties,",
				"          typename,",
				"          aggregates",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ColumnsForOutput",
				"ColumnsForOutput sort(asc(fullname, true)) ~> SortByFullname",
				"SortByFullname alterRow(upsertIf(true())) ~> Upsert",
				"SitesInWasteModelOffice, PointMapping join(fullname == legacy_scada,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> FindPointsMapping",
				"BuildRiseNames derive(rise_fullname = concat(new_fullname,'.', rise_relativename)) ~> FinalRiseNames",
				"split1@Matched filter(/*fullname=='WESTERN.READING.BASINGSTOKE.Stoneyfield SPS.Analogue.Average Calculation' || fullname=='WESTERN.READING.BASINGSTOKE.Stoneyfield SPS.Communications.GPRS Signal Strength' */\r",
				"true() /*enable this line to disable the filter*/) ~> DebuggingFilter",
				"GeoSCADAObjects, WasteModelOffice join(startsWith(fullname, concat(current_fullname, '.')),",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> SitesInWasteModelOffice",
				"FindPointsMapping split(fullname==legacy_scada,",
				"     disjoint: false) ~> split1@(Matched, Unmatched)",
				"split1@Unmatched split(isNull(legacy_scada),",
				"     disjoint: false) ~> Split2@(MissingInWWTDB, MissingInMappingSheet)",
				"Split2@MissingInWWTDB derive(Comment = 'Object Fullname has no matching legacy_scada name in the Points Mapping sheet') ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          id,",
				"          fullname,",
				"          typename,",
				"          current_fullname,",
				"          new_fullname,",
				"          Comment",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sort(asc(fullname, true)) ~> sort1",
				"Split2@MissingInMappingSheet derive(Comment = 'Point missing in WWT Database') ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          legacy_scada,",
				"          l4_site_name,",
				"          l5_process_group,",
				"          l6_asset_l1,",
				"          l7_asset_l2,",
				"          l8_signal,",
				"          extracted_site,",
				"          match_key,",
				"          generalised_key,",
				"          review_status,",
				"          point_type,",
				"          Comment",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sort(asc(legacy_scada, true)) ~> sort2",
				"FinalRiseNames window(over(rise_fullname),",
				"     asc(legacy_scada, true),",
				"     duplicate_row_number = rowNumber()) ~> window2",
				"window2 filter(duplicate_row_number > 1) ~> filter1",
				"window2 filter(duplicate_row_number == 1) ~> filter2",
				"filter1 select(mapColumn(",
				"          id,",
				"          typename,",
				"          legacy_scada,",
				"          rise_fullname",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"Upsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'rise_objects',",
				"     schemaName: 'public',",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['fullname'],",
				"     store: 'postgres',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkToDB",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'adfdiagnostics',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     partitionFileNames:[(concat(replace(toString(currentDate()),':',''),'_missing_legacy.csv'))],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> sink1",
				"sort2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'adfdiagnostics',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     partitionFileNames:[(concat(replace(toString(currentDate()),':',''),'_missing_in_wwt.csv'))],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'adfdiagnostics',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     partitionFileNames:[(concat(replace(toString(currentDate()),':',''),'_LegacyFullNamesWithDuplicateRiseNames.csv'))],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink3"
			]
		}
	}
}