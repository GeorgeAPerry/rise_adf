{
	"name": "Full Migration Pipeline",
	"properties": {
		"activities": [
			{
				"name": "Clear PostGres Rise Objects",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Clear PostGres Rise Objects Table",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "WWT Migration Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Clear PostGres Rise Objects",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "WWT Migration Pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "ExportJSON",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "WWT Migration Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzurePostgreSqlSource",
						"query": "SELECT fullname, typename, properties, aggregates FROM rise_objects\nORDER BY fullname asc",
						"partitionOption": "None",
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings",
							"filePattern": "arrayOfObjects"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "fullname",
									"type": "String"
								},
								"sink": {
									"path": "$['fullname']"
								}
							},
							{
								"source": {
									"name": "typename",
									"type": "String"
								},
								"sink": {
									"path": "$['typename']"
								}
							},
							{
								"source": {
									"name": "properties",
									"type": "String"
								},
								"sink": {
									"path": "$['properties']"
								}
							},
							{
								"source": {
									"name": "aggregates",
									"type": "String"
								},
								"sink": {
									"path": "$['aggregates']"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "DS_POST_RISE_Objects",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_BLOB_ADF_EXPORT",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}